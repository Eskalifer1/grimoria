{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!.yarn", "!public", "!yarn.lock"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended"
      },
      "complexity": {
        "noBannedTypes": "error"
      },
      "nursery": {
        "noInlineStyles": "error"
      },
      "style": {
        "noJsxLiterals": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        },
        "useExportType": "error",
        "useExportsLast": "error",
        "useImportType": "error",
        "useReactFunctionComponents": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              ["react", "react/**", "next", "next/**"],
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              [":PATH:", "!**/*.css"],
              ":BLANK_LINE:",
              ":STYLE:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [".vscode/*.json", ".claude/**/*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    },
    {
      "includes": ["messages/**/*.json"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "on"
          }
        }
      }
    },
    {
      "includes": ["src/shared/components/ui/**", "src/app/(payload)/**", "tests/**", "e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.svg"],
      "linter": {
        "rules": {
          "nursery": {
            "noInlineStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["src/shared/components/ui/**", "src/app/(payload)/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noInlineStyles": "off"
          },
          "style": {
            "useExportType": "off",
            "useExportsLast": "off",
            "useImportType": "off",
            "useReactFunctionComponents": "off"
          }
        }
      }
    },
    {
      "includes": ["src/shared/components/ui/**"],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/views/**",
        "src/features/**",
        "src/entities/**",
        "src/shared/components/**",
        "!src/shared/components/ui/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 200,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/views/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/views/**"],
                    "message": "views/ may import features/, entities/ and shared/ only, and never another screen module — see docs/agents/coding-standards/general.md → Layers."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/views/**", "@/features/**"],
                    "message": "features/ may import entities/ and shared/ only. Cross-feature: compose in views/ or move the primitive to entities/ — see docs/agents/coding-standards/general.md → Layers."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/entities/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/views/**", "@/features/**", "@/entities/**"],
                    "message": "entities/ may import shared/ only, and never another entity — see docs/agents/coding-standards/general.md → Layers."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/views/**", "@/features/**", "@/entities/**"],
                    "message": "shared/ never reaches up. Domain-bound code belongs in entities/ — see docs/agents/coding-standards/general.md → Layers."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
