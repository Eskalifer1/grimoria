# Signs Payload's auth tokens and encrypts stored credentials. Any long random
# string will do — generate one with `openssl rand -hex 32`.
PAYLOAD_SECRET=

# Pooled Neon connection string — the host carrying `-pooler`. Serves request
# traffic. Local `.env` points at the `dev` Neon branch, production at `main`
# (ADR-0007). Without it Payload boots, but everything touching the database
# fails, including `/cms`.
DATABASE_URL=

# The same branch's direct string — the same host without `-pooler`. Used only
# for schema work (dev push, `payload migrate`), which Neon's pooled endpoint
# cannot run. Falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=

# Signs Better Auth's own tokens. Nothing passes Better Auth a secret in code,
# so in production it throws at boot when this is unset. Its own value, not
# PAYLOAD_SECRET's.
BETTER_AUTH_SECRET=

# The origin Better Auth builds its URLs from, and the value the admin login
# screen is handed. Written out in production so a post-sign-in redirect cannot
# land on a preview URL (docs/database-migrations.md).
BETTER_AUTH_URL=http://localhost:3000

SEED_ADMIN_EMAIL=

SEED_ADMIN_PASSWORD=

SEED_ADMIN_NAME=