{
  "name": "grimoria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:migrate": "payload migrate && next build",
    "migrate:verify-rollback": "./scripts/verify-migration-rollback.sh",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "payload": "node scripts/patchPayloadAuth.mjs && payload",
    "generate:types": "yarn payload generate:types",
    "generate:importmap": "yarn payload generate:importmap",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "check:fix": "biome check --write",
    "ci": "biome ci",
    "spellcheck": "cspell lint --no-progress --show-suggestions",
    "postinstall": "node scripts/patchPayloadAuth.mjs",
    "seed": "yarn payload run scripts/seed.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.26",
    "@hookform/resolvers": "^5.9.1",
    "@payloadcms/db-postgres": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/ui": "3.87.1",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.8.1",
    "lucide-react": "^1.34.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "payload": "3.87.1",
    "payload-auth": "3.0.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@biomejs/biome": "2.5.6",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cspell": "^10.0.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "24.x"
  }
}
