{
  "name": "grimoria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:migrate": "payload migrate && next build",
    "migrate:verify-rollback": "./scripts/verify-migration-rollback.sh",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "payload": "node scripts/patchPayloadAuth.mjs && payload",
    "generate:types": "yarn payload generate:types",
    "generate:importmap": "yarn payload generate:importmap",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "check:fix": "biome check --write",
    "ci": "biome ci",
    "spellcheck": "cspell lint --no-progress --show-suggestions",
    "postinstall": "node scripts/patchPayloadAuth.mjs",
    "seed": "yarn payload run scripts/seed.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.6",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.8.1",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "payload": "3.90.2",
    "payload-auth": "3.0.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cspell": "^10.3.3",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "24.x"
  }
}
