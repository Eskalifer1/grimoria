{
  "permissions": {
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *-f*)",
      "Bash(git clean *--force*)",
      "Bash(git branch *-D*)",

      "Bash(sudo *)",
      "Bash(npm publish*)",
      "Bash(yarn npm publish*)",
      "Bash(vercel *--prod*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/docs-sync-check.sh\"",
            "statusMessage": "Checking docs are in sync before commit..."
          }
        ]
      }
    ]
  }
}
