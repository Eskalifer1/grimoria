{
  "outputStyle": "ELI5",
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gate-written-file.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "Monitor",
      "PushNotification",
      "RemoteTrigger",
      "SendMessage",
      "ListAgents",
      "DesignSync",
      "EnterWorktree",
      "ExitWorktree",
      "NotebookEdit",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "mcp__chrome-devtools",
      "mcp__ide",

      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *-f*)",
      "Bash(git clean *--force*)",
      "Bash(git branch *-D*)",

      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git * commit)",
      "Bash(git * commit *)",

      "Bash(sudo *)",
      "Bash(npm publish*)",
      "Bash(yarn npm publish*)",
      "Bash(vercel *--prod*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)"
    ]
  }
}
