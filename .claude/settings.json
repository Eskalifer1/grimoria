{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/docs-sync-check.sh\"",
            "if": "Bash(git commit*)",
            "statusMessage": "Checking docs are in sync before commit..."
          }
        ]
      }
    ]
  }
}
