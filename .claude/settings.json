{
  "outputStyle": "ELI5",
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableRemoteControl": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true,
  "env": {
    "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gate-written-file.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(.claude/bin/e2e-run.sh:*)"],
    "deny": [
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "PushNotification",
      "RemoteTrigger",
      "DesignSync",
      "EnterWorktree",
      "ExitWorktree",
      "NotebookEdit",
      "Artifact",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "mcp__chrome-devtools",
      "mcp__ide",
      "mcp__claude_ai_Google_Drive",

      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "EnterPlanMode",
      "ExitPlanMode",
      "AskUserQuestion",

      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *-f*)",
      "Bash(git clean *--force*)",
      "Bash(git branch *-D*)",

      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git * commit)",
      "Bash(git * commit *)",

      "Bash(sudo *)",
      "Bash(npm publish*)",
      "Bash(yarn npm publish*)",
      "Bash(vercel *--prod*)",

      "Read(./.env)",
      "Read(./secrets/**)",
      "Read(**/*.pem)"
    ]
  }
}
